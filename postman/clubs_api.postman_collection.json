        {
          "name": "Login (stores token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sunilmca09@gmail.com\",\n  \"password\": \"Test@1\",\n  \"device_id\": \"{{device_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/user/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let token = null;",
                  "try {",
                  "    const json = pm.response.json();",
                  "    token = json?.data?.token || null;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('access_token', token);",
                  "    }",
                  "} catch (e) {",
                  "    console.warn('Unable to parse login response', e);",
                  "}",
                  "if (!token) {",
                  "    pm.collectionVariables.unset('access_token');",
                  "}"
                ]
              }
            }
          ]
        },
